# Configuration of pg-backup-scaleway.sh, installed as /etc/gnomonitoring/pg-backup.env
# (owner root, mode 0600: the script refuses any other mode).
#
# KEY=VALUE lines, read as data (never executed). Values may be quoted.
# Every key except DISCORD_WEBHOOK_URL is optional; the values below are the defaults.

# Discord webhook that receives the failure notifications. A webhook URL is a
# credential: keep it in this file only, never in the repository, a command
# line or the shell history (edit this file with an editor).
DISCORD_WEBHOOK_URL=

# Also post a short message on every successful run (true or false).
NOTIFY_ON_SUCCESS=false

# Optional URL fetched (GET) after every successful run, for an external
# dead-man's switch such as healthchecks.io: it alerts when the backup did not
# run at all, which the failure notification cannot detect.
HEARTBEAT_URL=

# Optional *.prom file rewritten after every successful run, for a node_exporter
# or Grafana Alloy textfile collector: gnomonitoring_pg_backup_last_success_timestamp_seconds,
# _last_size_bytes and _last_duration_seconds. Alert when the timestamp is more
# than 30 hours old or missing. Its directory, and every parent, must be owned
# by root and not writable by group or others; otherwise the run warns and
# skips the metrics (the backup still runs).
METRICS_FILE=

# Postgres container and database (docker compose service "postgres").
PG_CONTAINER=gnomonitoring-postgres
PG_USER=gnomonitoring
PG_DB=gnomonitoring

# Destination: s3://<S3_BUCKET>/<S3_PREFIX>gnomonitoring-<UTC timestamp>.dump.age
# The aws CLI uses root's usual credentials (~/.aws); set AWS_PROFILE to pick a
# named profile.
S3_BUCKET=gnomonitoring
S3_PREFIX=postgres/
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
AWS_PROFILE=

# age public keys (one per line) the dump is encrypted to. Any matching
# private key decrypts it; no private key belongs on this server.
AGE_RECIPIENTS_FILE=/etc/gnomonitoring/pg-backup.recipients

# Local directory for the encrypted file before upload (removed after each run).
WORK_DIR=/var/tmp
# Required free space in WORK_DIR: this percentage of the database size on
# disk, plus the margin.
FREE_SPACE_PERCENT=100
FREE_SPACE_MARGIN_MB=1024

# Lock against overlapping runs, and the maximum duration of pg_dump.
LOCK_FILE=/run/gnomonitoring-pg-backup.lock
DUMP_TIMEOUT=4h
