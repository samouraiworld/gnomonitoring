# Backend config for compose_dev_chain.yml (local gnoland-test devnet).
# Copy to backend/config_dev_chain.yaml (gitignored) and adjust.

backend_port: "8989"
metrics_port: 8888
allow_origin: "*"

# dev_mode bypasses authentication: use the X-Debug-UserID header to act as a user.
dev_mode: true

# Optional: set real bot tokens to receive devnet alerts on Telegram.
token_telegram_validator: ""
token_telegram_govdao: ""

database:
  host: "postgres"
  port: 5432
  user: "gnomonitoring"
  password: ""  # must match POSTGRES_PASSWORD in the repository root .env
  dbname: "gnomonitoring"
  sslmode: "disable"

default_chain: "dev"

chains:
  # Reached by service name on the compose network.
  dev:
    rpc_endpoints:
      - "http://validator:26657"
    graphqls:
      - "http://tx-indexer:8546/graphql/query"
    gnowebs:
      - "http://gnoweb:8888"
    enabled: true
