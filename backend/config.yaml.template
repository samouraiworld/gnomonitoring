backend_port: "8989"
metrics_port: 8888
dev_mode: false
allow_origin: "http://localhost:3000"  # Comma-separated for multiple origins, e.g. "https://gnolove.world, https://memba.samourai.app"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# auth_provider selects which identity provider protects the API.
#   "clerk"    — the historical provider (default when this key is absent)
#   "keycloak" — the gno-world Keycloak realm
# Switching is a config edit, not a code change: both paths ship in the binary,
# so a failed cutover rolls back by setting this key back to "clerk".
auth_provider: "clerk"

# --- Clerk (used when auth_provider: clerk, and by the fallback below) ---
clerk_secret_key: "sk_test...."  # change me
# Admin access: set { "role": "admin" } in Clerk dashboard → User → Public metadata

# --- Keycloak (required when auth_provider: keycloak) ---
keycloak_issuer: ""  # e.g. "https://auth.samourai.app/realms/gno-world"
# Admin access: assign the "admin" role scoped to the gnomonitoring-panel
# CLIENT — Keycloak admin console → Clients → gnomonitoring-panel → Users in
# role, or Users → <user> → Role mapping → Filter by clients → Assign role.
# NOT the realm-wide role filter: gno-world is shared with memba and gnolove,
# and a realm-wide admin role would grant admin on all three.
#
# keycloak_clerk_fallback keeps the general routes (/webhooks/govdao,
# /webhooks/validator, /users, /alert-contacts, /usersH) accepting Clerk tokens
# in addition to Keycloak ones. Those routes are called by memba's /alerts page
# and gnolove's leaderboard-webhooks route with tokens from *their* Clerk
# sessions; turning this off before both apps have cut over to Keycloak breaks
# them with 401s. /admin/* is never dual-accept — the panel cuts over with this
# backend. Defaults to true when absent.
keycloak_clerk_fallback: true

token_telegram_validator: ""
token_telegram_govdao: ""

# Validator Health Report
# The endpoint GET /api/reports/validators?chain=X is always available.
# Per-chain daily-summary link inclusion is toggled via admin_config key validator_report_enabled.<chainID> (true/false).
# The base URL for summary links is set via admin_config key report_base_url (default: memba base URL).
# Neither are YAML keys — both are configured live in the admin panel Reports page without restart.
# See docs/validator-report-api.md and CLAUDE.md "Validator Health Report" for details.

database:
  host: "localhost"
  port: 5432
  user: "gnomonitoring"
  password: ""
  dbname: "gnomonitoring"
  sslmode: "disable"

# Local devnet: to test against the local Gno.land devnet started via
# gnoland-test/bootstrap.sh + docker compose, copy the `chains.local` entry
# from gnoland-test/config.devnet.yaml.example into the `chains:` map below.

# Default chain used when no ?chain= query parameter is supplied.
# Must match one of the enabled chain keys below. Falls back to the
# first enabled chain alphabetically if not set or invalid.
default_chain: "test12"

# Multi-chain configuration
# Each chain has its own RPC, GraphQL indexer, and gno.web endpoint.
#
# Fallback URLs are supported for rpc_endpoints, graphqls, and gnowebs.
# The system tries each URL in order and moves to the next on failure.
#
# Two equivalent forms are accepted:
#
#   Single URL (backward compatible):
#     rpc_endpoint: "https://rpc.primary.example.com"
#
#   Multiple URLs with automatic failover:
#     rpc_endpoints:
#       - "https://rpc.primary.example.com"
#       - "https://rpc.fallback.example.com"
#
# The plural form (rpc_endpoints / graphqls / gnowebs) takes precedence
# when both are present. Existing single-URL configs need no changes.
chains:
  test12:
    # Endpoints are tried in priority order. The first entry is the primary;
    # the pool fails over to the next one when it stops answering, and returns
    # to the primary on its own once it recovers (see rpc_health_check_seconds
    # in admin_config, default 60).
    rpc_endpoints:
      - "https://rpc.test12.testnets.gno.land"
      # - "https://rpc.test12-fallback.example.com"
    graphqls:
      - "https://indexer.test12.testnets.gno.land/graphql/query"
      # - "https://indexer.test12-fallback.example.com/graphql/query"
    gnowebs:
      - "https://test12.testnets.gno.land"
      # - "https://test12-fallback.testnets.gno.land"
    enabled: true

  gnoland1:
    rpc_endpoints:
      - "https://rpc.betanet.testnets.gno.land"
    graphqls:
      - "https://indexer.betanet.testnets.gno.land/graphql/query"
    gnowebs:
      - "https://betanet.testnets.gno.land"
    enabled: true

  test11:
    rpc_endpoints:
      - "https://rpc.test11.testnets.gno.land"
    graphqls:
      - "https://indexer.test11.testnets.gno.land/graphql/query"
    gnowebs:
      - "https://test11.testnets.gno.land"
    enabled: true