# Keycloak client config — gno-world realm, gnomonitoring-panel client.
# Leave all three unset to run the panel unauthenticated against a
# `dev_mode: true` backend.
VITE_KEYCLOAK_URL=https://auth.samourai.app
VITE_KEYCLOAK_REALM=gno-world
VITE_KEYCLOAK_CLIENT_ID=gnomonitoring-panel

# API base URL — leave empty for dev (uses Vite proxy), set for production
# VITE_API_BASE_URL=https://your-api.example.com
